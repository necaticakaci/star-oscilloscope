#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# After installing: an oscilloscope already plugged in gets the new udev rule without being unplugged.
set -e
if [ "$1" = configure ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=d4a2 --attr-match=idProduct=5661 || true
fi
exit 0
