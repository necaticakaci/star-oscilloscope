// SPDX-License-Identifier: GPL-3.0-or-later
// The icon and the version Windows shows for the executable, in Explorer, its Properties and on pinned shortcuts.
// The icon is made by tools/make_icon.cpp; CMake fills in the path and the version (app/CMakeLists.txt).
#pragma code_page(65001)  // UTF-8, for the names below
#include <winver.h>

IDI_ICON1 ICON "@STAROSC_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Necati Çakacı"
            VALUE "FileDescription", "Star Oscilloscope"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "star-oscilloscope"
            VALUE "LegalCopyright", "Copyright (C) 2026 Necati Çakacı. GPL-3.0-or-later."
            VALUE "OriginalFilename", "star-oscilloscope.exe"
            VALUE "ProductName", "Star Oscilloscope"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
